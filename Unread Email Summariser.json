    {
      "parameters": {
        "jsCode": "// Get all incoming items from the AI Agent node\nconst allItems = $input.all();\n\n// Extract the output text, filter out empty ones, and format each with a line break before the summary text\nconst combinedText = allItems\n  .map(item => item.json.output || item.json.text || '')\n  .filter(text => text.length > 0)\n  .map((text, index) => `Email ${index + 1}:\\n${text}`)\n  .join('\\n\\n'); // Double line break ensures a blank line between each email block\n\n// Return a single item containing the combined summaries string\nreturn [{\n  json: {\n    combinedSummaries: combinedText\n  }\n}];"
      },
