      "name": "Writer Agent"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior LinkedIn content reviewer and editor.\n\nReview and improve the LinkedIn post provided by the Writer Agent.\n\nDRAFT TO REVIEW:\n{{ $json.output }}\n\nFollow these review standards:\n\n1. Opening hook: Make the first sentence engaging.\n2. Professional tone: Keep the writing clear, credible, and suitable for LinkedIn.\n3. Content quality: Ensure the post provides useful insights and practical value.\n4. Grammar: Correct spelling, grammar, and punctuation.\n5. Readability: Use short paragraphs and remove unnecessary repetition.\n6. Accuracy: Remove unsupported statistics, fabricated facts, and exaggerated claims.\n7. Engagement: Finish with a meaningful question or call to action.\n8. Hashtags: Include 3–5 relevant hashtags.\n9. Length: Aim for 150–250 words where practical.\n\nRewrite the draft wherever necessary.\n\nReturn only the complete, improved LinkedIn post. Do not return review comments, scores, or explanations.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
