    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a professional LinkedIn post about the following topic:\n\nTopic: {{ $json.Topic }}\n\nRequirements:\n1. Start with an engaging opening hook.\n2. Explain the topic in clear, professional language.\n3. Include three useful insights, practical tips, or takeaways.\n4. Make the post relevant to IT professionals and technology leaders when appropriate.\n5. End with a meaningful question that encourages engagement.\n6. Use a natural, human tone.\n7. Use 3–5 relevant hashtags.\n8. Aim for 150–250 words.\n9. Do not invent statistics, personal experiences, quotations, or factual claims.\n10. Return only the draft post, without explaining your writing process.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -560,
        -208
